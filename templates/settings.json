// Generated by zed-latex init (https://github.com/ddxxlao/zed-latex-skim).
{
  "languages": {
    "LaTeX": {
      // Reformatting whole .tex files on save makes merges with co-authors painful.
      "format_on_save": "off",
      "soft_wrap": "editor_width"
    }
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            // texlab resolves %f to the root document, even from an \input file.
            "executable": "latexmk",
            "args": ["@ENGINE_FLAG@", "-interaction=nonstopmode", "-file-line-error", "-synctex=1", "%f"],
            "onSave": true,
            "forwardSearchAfter": true
          },
          "forwardSearch": {
            "executable": "@DISPLAYLINE@",
            "args": ["-r", "-g", "%l", "%p", "%f"]
          },
          "chktex": { "onOpenAndSave": false, "onEdit": false }
        }
      }
    }
  }
}
